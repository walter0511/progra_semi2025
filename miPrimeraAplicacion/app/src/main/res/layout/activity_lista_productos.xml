<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".lista_productos">

    <EditText
        android:id="@+id/txtBuscarProducto"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Buscar productos..."
        android:inputType="text"
        android:padding="8dp" />

    <ListView
        android:id="@+id/ltsProductos"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/txtBuscarProducto" />

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabAgregarProducto"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_alignParentEnd="true"
        android:layout_margin="16dp"
        android:contentDescription="Agregar producto"
        app:srcCompat="@android:drawable/ic_menu_add" />
</RelativeLayout>
